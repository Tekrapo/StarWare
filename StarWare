local function pulseGetRole(plr)
    local getter = getgenv().__pulseRoleGetter
    if type(getter) == "function" then
        local r = getter(plr)
        if r then return r end
    end
    local d = getgenv().__pulseRoster or getgenv().__pulseRoles
    if type(d)=="table" and d[plr.Name] then
        local e = d[plr.Name]
        if type(e)=="table" then return e.Role end
        return e
    end
    local function scan(container)
        if not container then return nil end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") then
                local n = tostring(t.Name):lower()
                if n:find("knife") then return "Murderer" end
                if n:find("gun") then return "Sheriff" end
            end
        end
    end
    local r = scan(plr.Character) or scan(plr:FindFirstChildOfClass("Backpack"))
    if r then return r end
    return "Innocent"
end
local function roleColor(role)
    if role=="Murderer" then return V.RoleESP.murderer end
    if role=="Sheriff"  then return V.RoleESP.sheriff end
    if role=="Innocent" then return V.RoleESP.innocent end
    if role=="Hero"     then return V.RoleESP.hero end
    return Color3.fromRGB(255,255,255)
end

