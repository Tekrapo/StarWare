V.Sakura = {on=false, queue={}, spawned=0, color=Color3.fromRGB(255,183,210)}
local function makePetal(color)
    local p=Instance.new("Part"); p.Name="PulsePetal"
    p.Size=Vector3.new(0.4,0.05,0.6); p.Color=color; p.Material=Enum.Material.Neon; p.Transparency=0.05
    p.CanCollide=false; p.CanQuery=false; p.CanTouch=false; p.Anchored=true; p.CastShadow=false
    return p
end
function V.Sakura.tick(dt)
    if not V.Sakura.on then return end
    V.Sakura.spawned = V.Sakura.spawned + dt
    if V.Sakura.spawned >= 0.05 then
        V.Sakura.spawned = 0
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local p = makePetal(V.Sakura.color)
            p.Position = hrp.Position + Vector3.new((math.random()-0.5)*30,18+math.random()*8,(math.random()-0.5)*30)
            p.Parent = workspace
            table.insert(V.Sakura.queue, { part=p, spawned=os.clock(), life=4+math.random()*3,
                speed=6+math.random()*6, sway=math.random()*math.pi*2,
                rot=CFrame.Angles(math.random()*6,math.random()*6,math.random()*6),
                rotSpeed=Vector3.new((math.random()-0.5)*3,(math.random()-0.5)*3,(math.random()-0.5)*3) })
        end
    end
    local t = os.clock()
    for i=#V.Sakura.queue,1,-1 do
        local d = V.Sakura.queue[i]
        if t-d.spawned >= d.life or not d.part.Parent then
            pcall(function() d.part:Destroy() end); table.remove(V.Sakura.queue, i)
        else
            local sway = math.sin(t*2+d.sway)*2
            d.part.CFrame = CFrame.new(d.part.Position.X+sway*dt*5, d.part.Position.Y-d.speed*dt,
                d.part.Position.Z+math.cos(t*1.7+d.sway)*2*dt*5) * d.rot
            d.rot = d.rot * CFrame.Angles(d.rotSpeed.X*dt, d.rotSpeed.Y*dt, d.rotSpeed.Z*dt)
            d.part.Transparency = math.min(0.85,(t-d.spawned)/d.life)
        end
    end
end
function V.Sakura.set(v, color)
    V.Sakura.on = v and true or false
    if color then V.Sakura.color = color end
    if not v then
        for _,d in ipairs(V.Sakura.queue) do if d.part then d.part:Destroy() end end
        V.Sakura.queue = {}
    end
end

V.Wings = {on=false, scale=1, model=nil, feathers={},
    color1=Color3.fromRGB(255,255,255), color2=Color3.fromRGB(255,230,160)}
local function clearWings()
    if V.Wings.model then pcall(function() V.Wings.model:Destroy() end) end
    V.Wings.model = nil
    V.Wings.feathers = {}
end
local function buildWings(char, scale)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    clearWings()
    local model = Instance.new("Model"); model.Name="PulseWings"
    local root = Instance.new("Part"); root.Name = "PulseWingsRoot"
    root.Size=Vector3.new(0.2,0.2,0.2); root.Transparency=1
    root.CanCollide=false; root.Massless=true; root.Anchored=false
    root.CanQuery=false; root.CanTouch=false; root.CastShadow=false
    root.Parent=model
    local rw = Instance.new("Weld"); rw.Part0=hrp; rw.Part1=root
    rw.C0 = CFrame.new(0,0.5,0.6); rw.Parent = root
    local SEG = 10
    for side=-1,1,2 do
        for i=1,SEG do
            local t = (i-1)/(SEG-1)
            local len = (1.8 + 3.2*(1-t)) * scale
            local f = Instance.new("Part"); f.Name="PulseFeather"
            f.Size=Vector3.new(0.35*scale, 0.12*scale, len)
            f.Color=V.Wings.color1:Lerp(V.Wings.color2, t*0.7)
            f.Material=Enum.Material.Neon; f.Transparency=0.08
            f.CanCollide=false; f.CanQuery=false; f.CanTouch=false
            f.Massless=true; f.CastShadow=false; f.Anchored=false
            f.TopSurface=Enum.SurfaceType.Smooth; f.BottomSurface=Enum.SurfaceType.Smooth
            local m = Instance.new("SpecialMesh",f); m.MeshType=Enum.MeshType.Wedge
            local pl = Instance.new("PointLight",f)
            pl.Color=f.Color; pl.Brightness=1.2; pl.Range=6
            f.Parent=model
            local angY = math.rad(side*(10+t*65)); local angX = math.rad(-25+t*70); local angZ = math.rad(side*(-5-t*25))
            local w = Instance.new("Weld"); w.Part0=root; w.Part1=f
            local c0 = CFrame.new(0,0,0)*CFrame.Angles(angX,angY,angZ)*CFrame.new(0,0,-len*0.5)
            w.C0 = c0; w.Parent=f
            table.insert(V.Wings.feathers, { part=f, weld=w, baseC0=c0, baseCol=f.Color, phase=t, side=side })
        end
    end
    model.Parent=char; V.Wings.model=model
end
local function updateWings()
    if not V.Wings.on then return end
    if not V.Wings.model or not V.Wings.model.Parent then return end
    local t = os.clock()
    for _, d in ipairs(V.Wings.feathers) do
        if d.weld and d.weld.Parent and d.part and d.part.Parent then
            local flap = math.sin(t*3 + d.phase*2) * math.rad(12) * (1 - d.phase*0.3)
            d.weld.C0 = d.baseC0 * CFrame.Angles(0, d.side*flap, 0)
            local pulse = 0.5 + 0.5*math.sin(t*4 + d.phase*6)
            d.part.Color = d.baseCol:Lerp(V.Wings.color1, pulse*0.5)
            d.part.Transparency = 0.05 + 0.12*(1-pulse)
        end
    end
end
function V.Wings.set(v, scale, c1, c2)
    V.Wings.on = v and true or false
    V.Wings.scale = scale or V.Wings.scale
    if c1 then V.Wings.color1 = c1 end
    if c2 then V.Wings.color2 = c2 end
    if V.Wings.on then buildWings(LP.Character, V.Wings.scale)
    else clearWings() end
end

V.Chams = { mat=Enum.Material.ForceField,
    selfColor=Color3.fromRGB(120,200,255), teamColor=Color3.fromRGB(120,255,140),
    gunColor=Color3.fromRGB(255,210,60), _st={}, _wp={}, selfOn=false, teamOn=false, gunOn=false }
local function isMe(p)
    local ch = p:FindFirstAncestorOfClass("Model")
    return ch and Players:GetPlayerFromCharacter(ch) == LP
end
function V.Chams.apply(char, color, mode)
    if not char then return end
    local st = V.Chams._st[char] or {ch={}, seen={}}
    V.Chams._st[char] = st
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 1 then
            local ok = (mode=="self" and isMe(p)) or (mode=="team" and not isMe(p))
            if ok then
                if not st.seen[p] then st.seen[p] = true; st.ch[#st.ch+1] = {p, p.Material, p.Color} end
                if p.Material ~= V.Chams.mat or p.Color ~= color then
                    pcall(function() p.Material=V.Chams.mat; p.Color=color end)
                end
            end
        end
    end
end
function V.Chams.clear(char)
    local st = V.Chams._st[char]; if not st then return end
    for _, e in ipairs(st.ch) do if e[1].Parent then pcall(function() e[1].Material=e[2]; e[1].Color=e[3] end) end end
    V.Chams._st[char] = nil
end
local function isWeaponPart(p)
    local n = tostring(p.Name):lower()
    local pn = (p.Parent and tostring(p.Parent.Name) or ""):lower()
    return n:find("knife") or n:find("gun") or pn:find("knife") or pn:find("gun")
end
function V.Chams.applyWeapon(container, color)
    if not container then return end
    color = color or V.Chams.gunColor
    for _, p in ipairs(container:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 1 and isWeaponPart(p) then
            if V.Chams._wp[p] == nil then V.Chams._wp[p] = {p.Material, p.Color} end
            if p.Material ~= V.Chams.mat or p.Color ~= color then
                pcall(function() p.Material=V.Chams.mat; p.Color=color end)
            end
        end
    end
end
function V.Chams.clearWeapon()
    for part, d in pairs(V.Chams._wp) do if part.Parent then pcall(function() part.Material=d[1]; part.Color=d[2] end) end end
    V.Chams._wp = {}
end
function V.Chams.clearAll()
    for char,_ in pairs(V.Chams._st) do V.Chams.clear(char) end
    V.Chams.clearWeapon()
end

