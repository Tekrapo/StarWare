local function drawLine(l, ax, ay, bx, by, color)
    local dx, dy = bx-ax, by-ay
    local len = math.sqrt(dx*dx+dy*dy)
    l.Size=UDim2.fromOffset(len, 1)
    l.Position=UDim2.fromOffset((ax+bx)/2, (ay+by)/2)
    l.Rotation=math.deg(math.atan2(dy, dx))
    l.BackgroundColor3=color; l.BackgroundTransparency=0; l.Visible=true
end
local function updateBoxLines(g, x1, y1, x2, y2, color, style)
    if style == "Corners" then
        local w = x2 - x1; local h = y2 - y1
        local cw = math.clamp(w*0.22, 5, 22); local ch = math.clamp(h*0.22, 5, 22)
        local lines = {
            {x1,y1,x1+cw,y1}, {x1,y1,x1,y1+ch},
            {x2-cw,y1,x2,y1}, {x2,y1,x2,y1+ch},
            {x1,y2,x1+cw,y2}, {x1,y2-ch,x1,y2},
            {x2-cw,y2,x2,y2}, {x2,y2-ch,x2,y2},
        }
        for i = 1, 8 do
            local l = g.box[i]
            if lines[i] then drawLine(l, lines[i][1], lines[i][2], lines[i][3], lines[i][4], color)
            else l.Visible = false end
        end
    else
        local lines = {
            {x1,y1,x2,y1}, {x1,y2,x2,y2}, {x1,y1,x1,y2}, {x2,y1,x2,y2},
        }
        for i = 1, 8 do
            local l = g.box[i]
            if lines[i] then drawLine(l, lines[i][1], lines[i][2], lines[i][3], lines[i][4], color)
            else l.Visible = false end
        end
    end
end
local function updateSkeleton(g, char, cam, color)
    local bones = getgenv().__pulseSkelBones
    if not bones then return end
    local set = char:FindFirstChild("UpperTorso") and bones.R15 or bones.R6
    if not set then return end
    local idx = 0
    for i=1,#set do
        local a,b = set[i][1], set[i][2]
        local pa = char:FindFirstChild(a[1]); local pb = char:FindFirstChild(b[1])
        if pa and pb and pa:IsA("BasePart") and pb:IsA("BasePart") then
            local wa = (pa.CFrame*CFrame.new(pa.Size.X*a[2], pa.Size.Y*a[3], pa.Size.Z*a[4])).Position
            local wb = (pb.CFrame*CFrame.new(pb.Size.X*b[2], pb.Size.Y*b[3], pb.Size.Z*b[4])).Position
            local sa = cam:WorldToViewportPoint(wa); local sb = cam:WorldToViewportPoint(wb)
            if sa.Z>0 and sb.Z>0 then
                idx = idx + 1
                local l = g.bones[idx]
                if l then drawLine(l, sa.X, sa.Y, sb.X, sb.Y, color) end
            end
        end
    end
    for i=idx+1,#g.bones do if g.bones[i].Visible then g.bones[i].Visible=false end end
end
local function roleEspTick()
    if not V.RoleESP.on then
        for plr,_ in pairs(V.RoleESP._guis) do destroyRoleGui(plr) end
        return
    end
    local myChar = LP.Character; local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            local role = pulseGetRole(plr)
            if role == "Innocent" then
                local hasGun = char and char:FindFirstChild("Gun") or (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Gun"))
                if hasGun then role = "Hero" end
            end
            local dist = (myHRP and hrp) and (myHRP.Position - hrp.Position).Magnitude or nil
            local inRange = (V.RoleESP.maxDist <= 0) or (dist and dist <= V.RoleESP.maxDist)
            if char and hum and hum.Health > 0 and hrp and role and inRange then
                local col = roleColor(role)
                local g = V.RoleESP._guis[plr]
                if not g then g = makeRoleGui(plr); V.RoleESP._guis[plr]=g end
                if not g.hl then
                    g.hl = Instance.new("Highlight")
                    g.hl.Name="PulseRoleHL"
                    g.hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                    g.hl.FillTransparency=0.4; g.hl.OutlineTransparency=0
                    g.hl.Parent=CG
                end
                if g.hl.Adornee ~= char then g.hl.Adornee = char end
                g.hl.FillColor = col; g.hl.OutlineColor = col
                g.gui.Adornee = hrp
                g.roleLbl.Visible = V.RoleESP.showRole
                if V.RoleESP.showRole then g.roleLbl.Text=role; g.roleLbl.TextColor3=col end
                g.nameLbl.Visible = V.RoleESP.showName
                if V.RoleESP.showName then g.nameLbl.Text=plr.DisplayName; g.nameLbl.TextColor3=col end
                g.distLbl.Visible = V.RoleESP.showDist and dist ~= nil
                if g.distLbl.Visible then
                    g.distLbl.Text = math.floor(dist).." studs"
                    g.distLbl.TextColor3 = Color3.fromRGB(200,200,200)
                end
                local y=0
                if g.roleLbl.Visible then g.roleLbl.Position=UDim2.new(0,0,0,y); y=y+18 end
                if g.nameLbl.Visible then g.nameLbl.Position=UDim2.new(0,0,0,y); y=y+15 end
                if g.distLbl.Visible then g.distLbl.Position=UDim2.new(0,0,0,y) end
                local cam = Cam; local root = char:FindFirstChild("HumanoidRootPart")
                if cam and root then
                    local headPart = char:FindFirstChild("Head")
                    local topPos, botPos
                    if headPart and headPart:IsA("BasePart") then
                        topPos = headPart.Position + Vector3.new(0, headPart.Size.Y*0.5, 0)
                    else topPos = hrp.Position + Vector3.new(0, 1, 0) end
                    botPos = root.Position - Vector3.new(0, 3, 0)
                    local sTop = cam:WorldToViewportPoint(topPos)
                    local sBot = cam:WorldToViewportPoint(botPos)
                    if sTop.Z > 0 and sBot.Z > 0 then
                        local h = math.abs(sBot.Y - sTop.Y)
                        if h > 3 then
                            local cx = (sTop.X + sBot.X) * 0.5
                            local w = h * 0.55
                            local bX1 = cx - w*0.5; local bX2 = cx + w*0.5
                            local bY1 = math.min(sTop.Y, sBot.Y); local bY2 = math.max(sTop.Y, sBot.Y)
                            if V.RoleESP.box then updateBoxLines(g, bX1, bY1, bX2, bY2, col, V.RoleESP.boxStyle)
                            else for _,l in ipairs(g.box) do l.Visible=false end end
                            if V.RoleESP.tracer then
                                local vs = cam.ViewportSize
                                local dx = cx - vs.X*0.5; local dy = bY1 - vs.Y
                                local len = math.sqrt(dx*dx+dy*dy)
                                g.tracer.Size=UDim2.fromOffset(len,1)
                                g.tracer.Position=UDim2.fromOffset((vs.X*0.5+cx)*0.5, (vs.Y+bY1)*0.5)
                                g.tracer.Rotation=math.deg(math.atan2(dy,dx))
                                g.tracer.BackgroundColor3=col; g.tracer.BackgroundTransparency=0; g.tracer.Visible=true
                            else g.tracer.Visible=false end
                            if V.RoleESP.skeleton then updateSkeleton(g, char, cam, col)
                            else for _,l in ipairs(g.bones) do l.Visible=false end end
                        end
                    end
                end
            else destroyRoleGui(plr) end
        end
    end
end
function V.RoleESP.set(v)
    V.RoleESP.on = v and true or false
    if not v then for plr,_ in pairs(V.RoleESP._guis) do destroyRoleGui(plr) end end
