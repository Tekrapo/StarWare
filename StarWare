local knifeHooked = {}
local function getKnifeTarget()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local rp2 = RaycastParams.new()
    rp2.FilterType = Enum.RaycastFilterType.Exclude
    rp2.FilterDescendantsInstances = { myChar, cam }
    local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector*KS.reach, rp2)
    if hit then
        local hitChar = hit.Instance:FindFirstAncestorOfClass("Model")
        local hitPlr = hitChar and Players:GetPlayerFromCharacter(hitChar)
        if hitPlr and hitPlr ~= LP then
            local hc = hitPlr.Character
            local hp = hc and (hc:FindFirstChild("HumanoidRootPart") or hc:FindFirstChild("Head") or hc:FindFirstChild("UpperTorso"))
            if hp then return hp end
        end
    end
    local best, bd = nil, KS.reach
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tpart = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if tpart and h and h.Health > 0 then
                local d = (tpart.Position - myRoot.Position).Magnitude
                if d < bd then bd = d; best = tpart end
            end
        end
    end
    return best
end
local function hookKnife(tool)
    if knifeHooked[tool] then return end
    local events = tool:FindFirstChild("Events"); if not events then return end
    local touched = events:FindFirstChild("HandleTouched")
    if not touched then return end
    local origFS = touched.FireServer
    if type(origFS) ~= "function" then return end
    knifeHooked[tool] = { origTouched = origFS, touched = touched }
    touched.FireServer = function(self, part, ...)
        if KS.enabled then
            local aimPart = getKnifeTarget()
            if aimPart then
                pcall(function() origFS(self, aimPart, ...) end)
                return
            end
        end
        return origFS(self, part, ...)
    end
end
local function unhookKnife(tool)
    local h = knifeHooked[tool]; if not h then return end
    pcall(function() h.touched.FireServer = h.origTouched end)
    knifeHooked[tool] = nil
end
local function tryHookKnife()
    local c = LP.Character; if not c then return end
    local knife = c:FindFirstChild("Knife")
    if knife then hookKnife(knife) end
    for tool, _ in pairs(knifeHooked) do
        if not tool.Parent or tool.Parent ~= c then unhookKnife(tool) end
    end
end

