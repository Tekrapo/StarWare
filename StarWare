ADDON.unload = function()
    ADDON.loaded = false
    SA.enabled=false; KS.enabled=false; KA.on=false; KA.all=false; autograb_on=false; BT.on=false
    grab_desc_stop()
    getgenv().KNIFE_AIM_RESOLVE = nil
    getgenv().__pulseRoleGetter = nil
    for tool, _ in pairs(knifeHooked) do unhookKnife(tool) end
    moveReset(); stopTroll(); stopAntiJump()
    pcall(restore_wb)
    workspace.Gravity = 196.2

    pcall(function() V.Weather.off() end)
    pcall(function() V.Fullbright.set(false) end)
    pcall(function() V.Sakura.set(false) end)
    pcall(function() V.Wings.set(false) end)
    pcall(function() V.Chams.clearAll() end)
    pcall(function() V.GunESP.set(false) end)
    pcall(function() V.XRay.set(false) end)
    pcall(function() V.RoleESP.set(false) end)
    pcall(function() V.Crosshair.set(false) end)
    pcall(function() V.Wobble.set(false) end)
    pcall(function() V.VFX.set(false) end)
    pcall(function() V.MapFF.set(false) end)
    pcall(function() if V.Weather.conn then V.Weather.conn:Disconnect() end end)
    pcall(function() if V.RoleESP._rootGui then V.RoleESP._rootGui:Destroy() end end)
    pcall(function() if V.SkinGUI.gui then V.SkinGUI.gui:Destroy() end end)

    safe_disconnect(pulseHb); pulseHb=nil
    safe_disconnect(mainHb); mainHb=nil
    safe_disconnect(idleConn); idleConn=nil
    safe_disconnect(charConn); charConn=nil
    safe_disconnect(bt_conn); bt_conn=nil
    pcall(bt_destroy)

    local m = WSH.m
    if m and WSH.hooked then
        pcall(function() setreadonly(m,false) end)
        for name, orig in pairs(WSH.hooked) do pcall(function() m[name]=orig end) end
        WSH.hooked=nil; WSH.m=nil
    end
    pcall(function()
        local cg = game.CoreGui:FindFirstChild("Orion")
        if cg then cg:Destroy() end
    end)
    getgenv().UN_ADDON = nil
    print("[addon] unloaded")
end

