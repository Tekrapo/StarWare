V.XRay = {on=false, strength=0.75, _orig={}, _queue={}, _idx=1}
local function shouldXRay(p)
    if not p:IsA("BasePart") then return false end
    if p:IsA("Terrain") then return false end
    if p.Transparency >= 1 then return false end
    local m = p:FindFirstAncestorWhichIsA("Model")
    while m do
        if Players:GetPlayerFromCharacter(m) then return false end
        m = m.Parent and m.Parent:FindFirstAncestorWhichIsA("Model") or nil
    end
    return true
end
local function xRayTick()
    if not V.XRay.on then
        for p, tr in pairs(V.XRay._orig) do if p.Parent then pcall(function() p.Transparency=tr end) end end
        V.XRay._orig = {}; V.XRay._queue = {}; V.XRay._idx = 1
        return
    end
    if #V.XRay._queue == 0 then
        for _, p in ipairs(workspace:GetDescendants()) do
            if shouldXRay(p) then table.insert(V.XRay._queue, p) end
        end
        V.XRay._idx = 1
    end
    local n = 0
    while V.XRay._idx <= #V.XRay._queue and n < 180 do
        local p = V.XRay._queue[V.XRay._idx]; V.XRay._idx = V.XRay._idx + 1; n = n + 1
        if p and p.Parent and V.XRay._orig[p] == nil then
            V.XRay._orig[p] = p.Transparency
            p.Transparency = math.min(1, p.Transparency + V.XRay.strength)
        end
    end
    if V.XRay._idx > #V.XRay._queue then V.XRay._queue = {}; V.XRay._idx = 1 end
end
function V.XRay.set(v, strength)
    V.XRay.on = v and true or false
    if strength then V.XRay.strength = strength end
    if not v then for p, tr in pairs(V.XRay._orig) do if p.Parent then pcall(function() p.Transparency=tr end) end end; V.XRay._orig={} end
end

