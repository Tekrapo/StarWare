local target_p, target_char, target_part, target_hum

local function refresh_target()
    refreshRoleCache()
    if not Cam then Cam = workspace.CurrentCamera end
    if not Cam then return end
    local keepCurrent=false; local curDist=math.huge
    if target_p and target_p.Character then
        local h = target_p.Character:FindFirstChild("Humanoid")
        local hd = target_p.Character:FindFirstChild("Head")
        local hrp = target_p.Character:FindFirstChild("HumanoidRootPart")
        if h and h.Health>0 and hd and cachedRole(target_p)=="m" then
            keepCurrent=true; curDist=(hd.Position - Cam.CFrame.Position).Magnitude
            if SA.antiJump and hrp then
                local vy = hrp.AssemblyLinearVelocity.Y
                if vy>8 then curDist=curDist*1.5 elseif vy>0 then curDist=curDist*1.0
                elseif vy>-25 then curDist=curDist*0.7 else curDist=curDist*0.5 end
            end
        end
    end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) and cachedRole(p)=="m" then
            local h = p.Character and p.Character:FindFirstChild("Head")
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local hv = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if h and hrp then
                local d = (h.Position - Cam.CFrame.Position).Magnitude
                if SA.antiJump and hv and hv.FloorMaterial==Enum.Material.Air then
                    local vy = hrp.AssemblyLinearVelocity.Y
                    if vy>8 then d=d*1.5 elseif vy>0 then d=d*1.0 elseif vy>-25 then d=d*0.7 else d=d*0.5 end
                end
                if d<bd then bd=d; best=p end
            end
        end
    end
    if keepCurrent and best ~= target_p and curDist < bd*1.4 then return end
    if best ~= target_p then target_p=best; target_char, target_part, target_hum=nil,nil,nil end
    if not best then return end
    local c = best.Character
    if c ~= target_char then target_char=c; target_part, target_hum=nil,nil end
    if not c then return end
    if not target_part or not target_part.Parent then
        target_part = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
    end
    if not target_hum or not target_hum.Parent then target_hum = c:FindFirstChildOfClass("Humanoid") end
end

local function nearest_player()
