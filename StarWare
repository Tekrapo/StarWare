local function SA_getVel(root)
    local list = SA_hist[root]
    if not list or #list<2 then return root.AssemblyLinearVelocity end
    local samples={}; local N=#list
    for i=2,N do
        local a,b = list[i-1], list[i]
        local dt = b[1]-a[1]
        if dt>0.005 and dt<0.3 then
            samples[#samples+1] = { vx=(b[2].X-a[2].X)/dt, vy=(b[2].Y-a[2].Y)/dt, vz=(b[2].Z-a[2].Z)/dt, w=(i/N)*(1/dt) }
        end
    end
    if #samples==0 then return root.AssemblyLinearVelocity end
    local vx,vy,vz,w = 0,0,0,0
    for _,s in ipairs(samples) do vx=vx+s.vx*s.w; vy=vy+s.vy*s.w; vz=vz+s.vz*s.w; w=w+s.w end
    if w<=0 then return root.AssemblyLinearVelocity end
    local v = Vector3.new(vx/w, vy/w, vz/w)
    if v.Magnitude>200 then v=v.Unit*200 end
    return v
end

local function SA_rayBlocked(a, b, ignore)
    local list = { workspace.CurrentCamera }
    for _,x in ipairs(ignore or {}) do table.insert(list, x) end
    local p = RaycastParams.new(); p.FilterType = Enum.RaycastFilterType.Exclude
    for _=1,8 do
        p.FilterDescendantsInstances = list
        local hit = workspace:Raycast(a, b-a, p)
        if not hit then return false end
        local i = hit.Instance
        if i.Transparency>=0.9 or not i.CanCollide then table.insert(list, i)
        else return true end
    end
    return true
end

local SA_BODY = { "UpperTorso","Torso","LowerTorso","Head","HumanoidRootPart","RightUpperArm","LeftUpperArm","Right Arm","Left Arm" }

local function SA_anyVisible(targetChar, origin)
    local myChar = LP.Character
    local ig = { targetChar }
    if myChar and myChar ~= targetChar then table.insert(ig, myChar) end
    for _, n in ipairs(SA_BODY) do
        local pt = targetChar:FindFirstChild(n)
        if pt and pt:IsA("BasePart") then
            if not SA_rayBlocked(origin, pt.Position, ig) then return true end
        end
    end
    return false
end

local function SA_wallCheck(origin, targetChar)
    if not SA.wallCheck then return true end
    if not origin or not targetChar then return false end
    local myChar = LP.Character
    local bodies = {}
    for _, n in ipairs(SA_BODY) do
        local p = targetChar:FindFirstChild(n)
        if p and p:IsA("BasePart") then bodies[#bodies+1]=p end
    end
    if #bodies==0 then return false end
    local ig = { targetChar }
    if myChar and myChar ~= targetChar then table.insert(ig, myChar) end
    local function clearFrom(o)
        if not o then return false end
        for _,p in ipairs(bodies) do
            if not SA_rayBlocked(o, p.Position, ig) then return true end
        end
        return false
    end
    if clearFrom(origin) then return true end
    if SA.wallCheckCamera then
        local cp = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position
        if cp and (cp-origin).Magnitude>0.5 and clearFrom(cp) then return true end
    end
    return false
end

local function SA_jumpScore(h2, root)
    if not h2 or not root then return 1 end
    local st = h2:GetState()
    if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then return 1.0 end
    local vy = root.AssemblyLinearVelocity.Y
    if vy>8 then return 0.55
    elseif vy>0 then return 0.75
    elseif vy>-25 then return 0.95
    else return 1.0 end
end

local function SA_predict(h2, root, lead)
    if not SA.autoPred then
        local v = SA_getVel(root)
        return Vector3.new(v.X*lead, math.clamp(v.Y*lead, -3, 3), v.Z*lead)
    end
    local vPhys = root.AssemblyLinearVelocity
    local md = h2 and h2.MoveDirection or Vector3.zero
    if h2 and h2.FloorMaterial==Enum.Material.Air then
        local dy = vPhys.Y*lead - 0.5*workspace.Gravity*lead*lead
        return Vector3.new(vPhys.X*lead, dy, vPhys.Z*lead)
    end
    local vMove = md.Magnitude>0.1 and (md.Unit*(h2 and h2.WalkSpeed or 16)) or Vector3.zero
    local vBase = vMove.Magnitude>0.5 and vMove or SA_getVel(root)
    if md.Magnitude>0.1 then
        local right = root.CFrame.RightVector
        local lateral = math.abs(right:Dot(md.Unit))
        lead = lead + lateral*0.04
    end
    return Vector3.new(vBase.X*lead, math.clamp(vBase.Y*lead, -3, 3), vBase.Z*lead)
end

local function SA_confidence(c, h2, root, muzzle)
    if not SA.bestMoment then return 1 end
    local s = 1
    if SA.antiJump then s = s*SA_jumpScore(h2, root) end
    if SA.wallCheck then
        local myChar = LP.Character
        local ig = { c }
        if myChar and myChar ~= c then table.insert(ig, myChar) end
        local vis, tot = 0, 0
        for _, n in ipairs(SA_BODY) do
            local pt = c:FindFirstChild(n)
            if pt and pt:IsA("BasePart") then
                tot=tot+1
                if not SA_rayBlocked(muzzle, pt.Position, ig) then vis=vis+1 end
            end
        end
        if tot>0 then s = s*(0.5+0.5*(vis/tot)) end
    end
    local phase = SA_phase[c]
    if h2 and h2.MoveDirection.Magnitude>0.1 then
        if phase and phase.lastMd and phase.lastMd.Magnitude>0.1 then
            local dot = h2.MoveDirection.Unit:Dot(phase.lastMd.Unit)
            if dot<0.5 then s=s*0.85 end
        end
        SA_phase[c] = { lastMd = h2.MoveDirection }
    else
        SA_phase[c] = nil
    end
    return s
end

local function SA_findWbSpot(mRoot, muzzle)
    local mChar = mRoot.Parent
    local toM = muzzle - mRoot.Position
    local base = math.atan2(toM.Z, toM.X)
    for _, dist in ipairs({ 1.5, 2.5, 3.5, 5, 7, 9 }) do
        for k=0,23 do
            local ang = base + (k%2==0 and 1 or -1)*math.ceil(k/2)*(math.pi/12)
            for _, h in ipairs({ 1, 2, 3, 4.5, 6 }) do
                local p = mRoot.Position + Vector3.new(math.cos(ang)*dist, h, math.sin(ang)*dist)
                if not SA_rayBlocked(p, mRoot.Position, { mChar }) and SA_anyVisible(mChar, p) then return p end
            end
        end
    end
end

local function SA_findQuietSpot(mRoot, myChar)
    local root = myChar:FindFirstChild("HumanoidRootPart"); if not root then return end
    local facing = CFrame.lookAt(root.Position, Vector3.new(mRoot.Position.X, root.Position.Y, mRoot.Position.Z))
    for _, off in ipairs({ Vector3.new(0,0,4), Vector3.new(0,0,-4), Vector3.new(4,0,0), Vector3.new(-4,0,0), Vector3.new(0,5,3), Vector3.new(0,2,2) }) do
        local pos = (facing*CFrame.new(off)).Position
        if not SA_rayBlocked(root.Position, pos) and not SA_rayBlocked(pos, mRoot.Position) then
            return CFrame.lookAt(pos, mRoot.Position)
        end
    end
end

local WSH = {}
local function get_ws_fn()
    local ok,m=pcall(function() return require(Replicated:WaitForChild("ClientServices"):WaitForChild("WeaponService")) end)
    if ok and type(m)=="table" then return m end
    return WSH.m
end

local function findMuzzle()
    local myChar = LP.Character; if not myChar then return nil end
    for _, n in ipairs({
        "GunRaycastAttachment","GunMuzzleAttachment","MuzzleAttachment","Muzzle","GunMuzzle",
        "BarrelAttachment","FirePointAttachment","FirePoint",
    }) do
        local a = myChar:FindFirstChild(n, true)
        if a and a:IsA("Attachment") then return a.WorldPosition end
    end
    local att = myChar:FindFirstChild("GunRaycastAttachment")
    if att and att:IsA("Attachment") then return att.WorldPosition end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    return myRoot and myRoot.Position
end

local function resolve()
    if not SA.enabled then return nil end
    if not target_p or not target_p.Character then pcall(refresh_target); if not target_p then return nil end end
    local c = target_char
    if not c or not c.Parent then pcall(refresh_target); c = target_char end
    if not c then return nil end
    local root = c:FindFirstChild("HumanoidRootPart"); if not root then return nil end
    local h2 = c:FindFirstChildOfClass("Humanoid")
    local lead = math.clamp(EC.rtt, 0.05, 0.45); if lead<0.09 then lead=0.09 end
    local off = SA_predict(h2, root, lead)
    local myChar = LP.Character
    local muzzle = findMuzzle()
    if not muzzle then return nil end
    if SA.wallCheck then
        local losMuzzle = SA_wallCheck(muzzle, c)
        local camCf = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position
        local losCamera = SA.wallCheckCamera and SA_wallCheck(camCf, c)
        if not (losMuzzle or losCamera) then return nil end
    end
    local conf = SA_confidence(c, h2, root, muzzle)
    if conf < SA.confFloor then return nil end
    local wbSpot
    if not SA.wallCheck and SA.wb and SA_rayBlocked(muzzle, root.Position, { c, myChar }) and not SA_anyVisible(c, muzzle) then
        wbSpot = SA_findWbSpot(root, muzzle)
    end
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local att = myRoot and myRoot:FindFirstChild("GunRaycastAttachment")
    if wbSpot and att then
        SA.wbTemp = { att=att, orig=att.WorldCFrame }
        pcall(function() att.WorldCFrame = CFrame.new(wbSpot) end)
    else SA.wbTemp = nil end
    local quietCf
    if SA.quiet and not wbSpot then quietCf = SA_findQuietSpot(root, myChar) end
    local order = SA.part=="Head"
        and { "Head","UpperTorso","Torso","HumanoidRootPart","LowerTorso" }
        or { "UpperTorso","Torso","LowerTorso","HumanoidRootPart","Head" }
    local fromPos = wbSpot or (quietCf and quietCf.Position) or muzzle
    rp.FilterDescendantsInstances = { myChar, workspace.CurrentCamera }
    local candidates = {}
    for _, name in ipairs(order) do
        local part = c:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local aimPos = part.Position + off
            local hit = workspace:Raycast(fromPos, aimPos-fromPos, rp)
            if not hit or hit.Instance:IsDescendantOf(c) then
                table.insert(candidates, { pos=aimPos, dist=(aimPos-fromPos).Magnitude })
            end
        end
    end
    if #candidates>0 then
        table.sort(candidates, function(a,b) return a.dist < b.dist end)
        return candidates[1].pos
    end
    if wbSpot then
        for _, name in ipairs(order) do
            local part = c:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                local aimPos = part.Position + off
                local hit = workspace:Raycast(wbSpot, aimPos-wbSpot, rp)
                if not hit or hit.Instance:IsDescendantOf(c) then return aimPos end
            end
        end
    end
    local fallback
    for _, name in ipairs(order) do
        local part = c:FindFirstChild(name)
        if part and part:IsA("BasePart") then fallback = fallback or (part.Position + off); break end
    end
    return fallback or (root.Position + off)
end

local function restore_wb()
    if SA.wbTemp then pcall(function() SA.wbTemp.att.WorldCFrame = SA.wbTemp.orig end); SA.wbTemp = nil end
end

local function install_hooks()
    local cur = get_ws_fn(); if not cur then return end
    if cur ~= WSH.m then WSH.m = cur; WSH.hooked = {} end
    if not WSH.hooked then WSH.hooked = {} end
    pcall(function() setreadonly(cur,false) end)
    local aimCandidates = {
        "GetMouseTargetCFrame","GetTargetPosition","GetTargetCFrame","GetAimPosition",
        "GetShootCFrame","GetShootTarget","GetBulletOrigin","CalculateAim",
        "ComputeTarget","GetFiringVector","GetShotOrigin","GetGunFireData",
        "GetAimTarget","GetAimCFrame","GetTargetPos","GetShotPosition","GetShootPosition",
        "GetBulletTarget","GetFirePosition","GetFireTarget","GetGunTarget",
    }
    for _, name in ipairs(aimCandidates) do
        if type(cur[name])=="function" and not WSH.hooked[name] then
            local orig = cur[name]
            cur[name] = function(self, ...)
                local ok_o, orig_r = pcall(orig, self, ...)
                local pt = resolve()
                if pt then
                    if ok_o and typeof(orig_r) == "CFrame" then
                        return CFrame.lookAt(orig_r.Position, pt)
                    end
                    if ok_o and typeof(orig_r) == "Vector3" then
                        return pt
                    end
                    local cam = workspace.CurrentCamera
                    if cam then return CFrame.lookAt(cam.CFrame.Position, pt) end
                    return CFrame.new(pt)
                end
                return orig_r
            end
            WSH.hooked[name] = orig
        end
    end
    local fireCandidates = {
        "FireServer","Fire","Shoot","FireGun","FireWeapon","FireBullet","ShootGun","TriggerGun",
        "FireGunServer","FireWeaponServer","ShootServer","TriggerFire",
    }
    for _, name in ipairs(fireCandidates) do
        if type(cur[name])=="function" and not WSH.hooked[name] then
            local orig = cur[name]
            cur[name] = function(self, ...)
                local r = orig(self, ...)
                if SA.wbTemp then
                    task.defer(function() restore_wb() end)
                    task.delay(0.08, function() restore_wb() end)
                end
                return r
            end
            WSH.hooked[name] = orig
        end
    end
end

