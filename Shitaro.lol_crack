local v246
local ok2, result2 = pcall(function()
    local Remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 8)
    Remotes = Remotes and Remotes:WaitForChild("Extras", 5)
    Remotes = Remotes and Remotes:WaitForChild("GetFullInventory", 5)
    if Remotes then return Remotes:InvokeServer(LocalPlayer.Name) end
    return nil
end)

if ok2 and type(result2) == "table" then v246 = result2 end
if type(v246) ~= "table" then v246 = {} end
if type(v246.Weapons) ~= "table" then v246.Weapons = {} end
if type(v246.Weapons.Owned) ~= "table" then v246.Weapons.Owned = {} end

local function v250(p35, p36, p37, p38, p39)
    if p36 == "Pet" then p37 = "Pet" end
    local v251 = string.lower(tostring(p35 or ""))
    if p38 then
        v251 = "chroma " .. v251
        p37 = "Chroma"
    end
    if p37 == "Classic" then p37 = "Vintage" end
    local v252 = lib2[p37]
    if not v252 then return nil end
    local v253 = string.lower(tostring(p36 or ""))
    local v254 = tostring(p39 or "")
    local t32 = {}
    if v254 ~= "" and v253 ~= "" then
        t32[#t32 + 1] = v251 .. " (" .. v253 .. ") (" .. v254 .. ")"
        t32[#t32 + 1] = v251 .. " " .. v253 .. " (" .. v254 .. ")"
    end
    if v254 ~= "" then
        t32[#t32 + 1] = v251 .. " (" .. v254 .. ")"
        t32[#t32 + 1] = v251 .. " " .. v254
    end
    if v253 ~= "" then
        t32[#t32 + 1] = v251 .. " (" .. v253 .. ")"
        t32[#t32 + 1] = v251 .. " " .. v253
    end
    t32[#t32 + 1] = v251
    for _, v in ipairs(t32) do
        local v258 = v252[v]
        if v258 then return v258 end
    end
    if v254 ~= "" then
        local v259
        for k, v in pairs(v252) do
            if string.match(k, "%[%a+(%d%d%d%d)%]") == v254 then
                local v262 = string.match(string.gsub(string.gsub(k, "%s*%[%a+%d+%]%s*", " "), "%s+", " "), "^%s*(.-)%s*$")
                if v262 == v251 or v253 ~= "" and (v262 == v251 .. " (" .. v253 .. ")" or v262 == v251 .. " " .. v253) then
                    if v259 == nil or v > v259 then v259 = v end
                end
            end
        end
        if v259 then return v259 end
    end
    return nil
end

local v263 = table.find(t2, min_rarity) or 1

for k, v in pairs(v246.Weapons.Owned) do
    local v267 = lib[k]
    if v267 then
        local Rarity = v267.Rarity
        local v269 = table.find(t2, Rarity)
        if v269 and v269 >= v263 then
            local ItemName = v267.ItemName or v267.Name or k
            local v271 = v267.Chroma == true and "Chroma " .. ItemName or ItemName
            local v272 = ({ NikKnife = 1000000 })[k] or v250(ItemName, v267.ItemType, Rarity, v267.Chroma == true, v267.Year)
            if not v272 then
                if table.find(t2, "Godly") <= v269 then v272 = 2 else v272 = 1 end
            end
            
            n7 += (v272 * v)
            table.insert(t1, {
                RealName = v271,
                DataID = k,
                Rarity = Rarity,
                Amount = v,
                Value = v272,
                ItemType = v267.ItemType
            })
        end
    end
end

getinv = function()
    return game:GetService("ReplicatedStorage").Remotes.Extras.GetFullInventory:InvokeServer(LocalPlayer.Name).Weapons.Owned
end

