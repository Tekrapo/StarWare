task.spawn(function()
    while true do
        task.wait(240)
        local ok, should_break = pcall(function()
            local new_code = game:HttpGet(UPDATE_URL .. (UPDATE_URL:find("%?") and "&" or "?") .. "t=" .. tostring(tick()))
            if new_code and #new_code > 100 and string.find(new_code, "local ") then
                getgenv().nubas = false
                loadstring(new_code)()
                return true
            end
            return false
        end)
        if ok and should_break then break end
    end
end)

